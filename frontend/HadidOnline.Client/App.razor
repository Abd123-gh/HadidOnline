<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(PublicLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <LoadingState Title="جاري التحقق من الصلاحيات" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(PublicLayout)">
                <section class="not-found page-pad">
                    <p class="eyebrow">404</p>
                    <h1>الصفحة غير موجودة</h1>
                    <p>الرابط المطلوب غير متاح، يمكنك العودة للصفحة الرئيسية أو لوحة الإدارة.</p>
                    <a class="btn primary" href="/">العودة للرئيسية</a>
                </section>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
