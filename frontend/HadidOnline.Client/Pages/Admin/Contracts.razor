@page "/admin/contracts"
@attribute [Authorize]
@layout AdminLayout
<AdminCrudPage TItem="ContractDto" TCreate="UpsertContractDto" Endpoint="contracts" Title="إدارة العقود" Description="العقود المؤسسية والمدرسية والسياحية مع الدورات والفترات." CreateLabel="عقد جديد" DefaultStatus="active" Columns="_columns" CreateFactory="NewContract"><FormTemplate Context="m"><div class="form-grid"><select class="input" @bind="m.Type"><option value="corporate">شركات</option><option value="school">مدارس</option><option value="tourist">سياحي</option></select><input class="input" type="number" placeholder="القيمة الشهرية" @bind="m.MonthlyAmount"/><input class="input" type="date" @bind="m.StartDate"/><input class="input" type="date" @bind="m.EndDate"/></div></FormTemplate></AdminCrudPage>
@code{private readonly List<AdminColumn<ContractDto>> _columns=[new("رقم العقد",x=>x.ContractNumber),new("النوع",x=>x.Type),new("الحالة",x=>x.Status),new("البداية",x=>x.StartDate?.ToString()??"—"),new("النهاية",x=>x.EndDate?.ToString()??"—"),new("القيمة",x=>(x.MonthlyAmount??x.TotalAmount)?.ToString("N0")??"—")]; private static UpsertContractDto NewContract()=>new(null,null,"corporate","new",DateOnly.FromDateTime(DateTime.Today),DateOnly.FromDateTime(DateTime.Today.AddMonths(12)),null,null,"monthly",null,null);}
