@code{private readonly List<AdminColumn<VehicleDto>> _columns=[new("المركبة",x=>x.Name),new("النوع",x=>x.Type),new("اللوحة",x=>x.PlateNumber),new("السعة",x=>x.Capacity.ToString()),new("الراحة",x=>x.ComfortLevel),new("الحالة",x=>x.Status)]; private static UpsertVehicleDto NewVehicle()=>new("","bus","",45,null,2026,true,true,true,"business","available",null,null,null,null);}
