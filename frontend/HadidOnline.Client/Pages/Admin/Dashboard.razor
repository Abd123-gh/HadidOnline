@page "/admin"
@attribute [Authorize]
@layout AdminLayout
@inject DashboardService Dashboard
<section class="admin-page"><div class="page-heading"><div><p class="eyebrow">نظرة عامة</p><h1>لوحة معلومات Hadid Online</h1><span>مؤشرات مباشرة للحجوزات والعقود والأسطول والإيرادات.</span></div><a class="btn primary" href="/admin/bookings">إدارة الحجوزات</a></div>@if(_loading){<LoadingState/>}else{<div class="metrics-grid"><MetricCard Icon="▣" Label="الحجوزات" Value="@_stats.Bookings.ToString()" Trend="طلبات نشطة"/><MetricCard Icon="▤" Label="العقود" Value="@_stats.Contracts.ToString()" Trend="شهري/سنوي"/><MetricCard Icon="▰" Label="المركبات" Value="@_stats.Vehicles.ToString()" Trend="@_stats.AvailableVehicles متاحة"/><MetricCard Icon="◉" Label="العملاء" Value="@_stats.Customers.ToString()" Trend="شركات ومدارس"/><MetricCard Icon="◫" Label="الإيرادات" Value="@($"{_stats.Revenue:N0} ر.س")" Trend="إجمالي"/></div><div class="dashboard-grid"><article class="chart-card"><h3>أداء الحجوزات</h3><div class="bar-chart"><span style="height:70%"></span><span style="height:45%"></span><span style="height:90%"></span><span style="height:58%"></span><span style="height:78%"></span></div></article><article class="chart-card"><h3>حالة الأسطول</h3><div class="donut"><b>@_stats.AvailableVehicles</b><small>متاحة</small></div><p>مشغولة: @_stats.BusyVehicles · الإجمالي: @_stats.Vehicles</p></article></div>}</section>
@code{private DashboardStats _stats=new(0,0,0,0,0,0,0); private bool _loading=true; protected override async Task OnInitializedAsync(){try{_stats=await Dashboard.GetStatsAsync();}catch{}finally{_loading=false;}}}
