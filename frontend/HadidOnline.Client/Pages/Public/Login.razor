@page "/login"
@layout PublicLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject ToastService Toasts
<section class="login-page page-pad"><EditForm Model="_login" OnValidSubmit="Submit" class="login-card"><Logo/><h1>تسجيل دخول الإدارة</h1><p>استخدم حساب JWT المرتبط بواجهة ASP.NET Core Web API.</p><input class="input" type="email" placeholder="البريد الإلكتروني" @bind="_login.Email"/><input class="input" type="password" placeholder="كلمة المرور" @bind="_login.Password"/><button class="btn primary wide" disabled="@_loading">@(_loading?"جاري الدخول...":"دخول لوحة الإدارة")</button></EditForm></section>
@code{[SupplyParameterFromQuery] public string? ReturnUrl{get;set;} private LoginRequest _login=new("",""); private bool _loading; private async Task Submit(){_loading=true;try{await Auth.LoginAsync(_login); Toasts.Success("مرحباً بك في لوحة الإدارة"); Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl)?"/admin":ReturnUrl);}catch{Toasts.Error("بيانات الدخول غير صحيحة أو API غير متاح");}finally{_loading=false;}}}
