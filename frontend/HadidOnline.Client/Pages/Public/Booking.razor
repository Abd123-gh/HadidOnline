@page "/booking"
@inject ApiClient Api
@inject ToastService Toasts
<PageTitle>حجز رحلة | Hadid Online</PageTitle>
<section class="subhero"><p class="eyebrow">احجز الآن</p><h1>طلب نقل ذكي ومتكامل</h1><p>نفس تدفق الحجز العربي: بيانات العميل، نوع الرحلة، الموعد، الركاب، نقطة الانطلاق والوجهة.</p></section>
<section class="container booking-layout section"><EditForm Model="_form" OnValidSubmit="Submit" class="booking-form"><DataAnnotationsValidator/><div class="form-grid"><label>الاسم<input class="input" @bind="_form.ClientName" required /></label><label>الجوال<input class="input" @bind="_form.ClientPhone" required /></label><label>البريد<input class="input" type="email" @bind="_form.ClientEmail" /></label><label>نوع الرحلة<select class="input" @bind="_form.TripType"><option value="tourist">سياحية</option><option value="corporate">شركات</option><option value="school">مدرسية</option><option value="private">خاصة</option></select></label><label>نوع العقد<select class="input" @bind="_form.ContractType"><option value="one_time">مرة واحدة</option><option value="monthly">شهري</option><option value="yearly">سنوي</option><option value="recurring">متكرر</option></select></label><label>التاريخ<input class="input" type="date" @bind="_form.TripDate" /></label><label>الوقت<input class="input" type="time" @bind="_form.TripTime" /></label><label>عدد الركاب<input class="input" type="number" min="1" @bind="_form.Passengers" /></label><label>نقطة الانطلاق<input class="input" @bind="_form.PickupLocation" required /></label><label>الوجهة<input class="input" @bind="_form.Destination" required /></label><label>تفضيل المركبة<select class="input" @bind="_form.VehiclePreference"><option value="">بدون تفضيل</option><option value="bus">حافلة</option><option value="van">فان</option><option value="vip">VIP</option></select></label><label class="switch-row"><input type="checkbox" @bind="_form.ReturnTrip" /> رحلة عودة</label></div><label>ملاحظات<textarea class="input" rows="4" @bind="_form.Notes"></textarea></label><button class="btn primary wide" disabled="@_saving">@(_saving ? "جاري الإرسال..." : "إرسال طلب الحجز")</button></EditForm><aside class="booking-summary"><h3>ماذا يحدث بعد الإرسال؟</h3><ol><li>تصل بياناتك إلى API الحجوزات.</li><li>يقوم فريق التشغيل بمراجعة الطلب.</li><li>يتم تأكيد المركبة والسائق والسعر.</li></ol><a class="btn ghost wide" href="tel:+966550000000">اتصال مباشر</a></aside></section>
@code{private BookingFormModel _form=new(); private bool _saving; private async Task Submit(){_saving=true; try{var dto=new UpsertBookingDto(_form.ClientName,_form.ClientPhone,_form.ClientEmail,_form.TripType,_form.ContractType,_form.PickupLocation,_form.Destination,_form.TripDate,_form.TripTime,_form.ReturnTrip,_form.ReturnDate,null,_form.Passengers,null,null,_form.VehiclePreference,null,"website",_form.Notes); await Api.CreateAsync<BookingDto>("bookings",dto); Toasts.Success("تم إرسال طلب الحجز بنجاح"); _form=new();}catch{Toasts.Error("تعذر إرسال الحجز، تحقق من اتصال API");}finally{_saving=false;}}
}
